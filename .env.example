# REQUIRED: copy to .env.local for development; use host secrets for production.
# All variables below are server-only. Never prefix them with NEXT_PUBLIC_.
# Use the intended Neon project/branch/database. Do not paste production secrets into Git.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DBNAME?sslmode=verify-full
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Exact application origin; also the sole Better Auth trusted origin and mutation origin.
# Development: localhost and 127.0.0.1 are different origins.
# Production MUST use the final HTTPS origin, e.g. https://journal.example.com.
# Production localhost values are rejected; no separate trusted-origins variable exists.
BETTER_AUTH_URL=http://localhost:3000
# OPTIONAL EMAIL: signup/sign-in can work without email when verification is false.
# Required for password recovery delivery; use a sender verified in Resend.
RESEND_API_KEY=
AUTH_EMAIL_FROM=MSJournal <auth@YOUR-VERIFIED-DOMAIN>
# Enable only after Resend delivery and verification links are tested.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# DEVELOPMENT/TEST ONLY: never enable disposable fixtures in a release environment.
MSJOURNAL_TEST_DISPOSABLE=false

# OPTIONAL PRIVATE IMAGES: notes and structured backups work without storage.
# Existing private S3-compatible bucket, with get/put/delete permissions for app objects.
SCREENSHOT_S3_BUCKET=
# AWS: the bucket's actual region; R2: auto.
SCREENSHOT_S3_REGION=
SCREENSHOT_S3_ACCESS_KEY_ID=
SCREENSHOT_S3_SECRET_ACCESS_KEY=
# Leave endpoint empty for AWS S3; R2 uses https://ACCOUNT_ID.r2.cloudflarestorage.com
SCREENSHOT_S3_ENDPOINT=
SCREENSHOT_S3_FORCE_PATH_STYLE=false

# PUBLIC SEO CONFIGURATION (server-only; independent from local authentication URL).
# Stable production HTTPS origin. Never use a preview deployment or localhost.
SITE_URL=https://ms-journal.vercel.app
# Optional: only the content value from Google Search Console HTML-tag verification.
GOOGLE_SITE_VERIFICATION=

# OPTIONAL BILLING: Free works without Whop. Keep public live checkout disabled.
# Use sandbox credentials only in development; sandbox is disabled in production.
WHOP_ENVIRONMENT=sandbox
WHOP_API_KEY=
WHOP_BUSINESS_ID=
WHOP_PRO_PRODUCT_ID=
# Required for launch: $9.99 USD every 30 days; no initial charge or trial.
WHOP_PRO_MONTHLY_PLAN_ID=
# Optional later: $89.99 USD every 365 days; hidden until verified against Whop.
WHOP_PRO_ANNUAL_PLAN_ID=
# Optional legacy membership allowlist. Prefer the explicit IDs above for checkout.
# A single legacy ID can serve Monthly only if its price/currency/interval match.
WHOP_PRO_PLAN_IDS=
# Copy the complete webhook signing secret, including its ws_ prefix.
WHOP_WEBHOOK_SECRET=
# OAuth application ID for securely connecting an existing subscription.
WHOP_OAUTH_CLIENT_ID=
WHOP_CHECKOUT_ENABLED=false
# Separate release gate. Do not enable until payment-to-access is verified.
WHOP_LIVE_VERIFIED=false
# Independent random bearer secret for GET /api/billing/reconcile.
BILLING_RECONCILE_SECRET=
