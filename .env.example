# Use an intended DEVELOPMENT Neon database's direct Postgres connection string.
# Copy to .env.local; never put secrets in chat or commit .env.local.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DBNAME?sslmode=verify-full
# Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Exact browser origin, no path; localhost and 127.0.0.1 are different origins.
BETTER_AUTH_URL=http://localhost:3000
OWNER_EMAIL=you@example.com
# Optional only for local CLI commands; omit to use a hidden terminal prompt.
# Remove from the environment after the command; do not save it in this file.
# MSJOURNAL_OWNER_PASSWORD=
# Optional browser fixtures: ONLY when DATABASE_URL points to a disposable branch.
# MSJOURNAL_TEST_DISPOSABLE=true
# MSJOURNAL_TEST_OWNER_PASSWORD=
