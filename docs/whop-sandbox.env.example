# Copy this file to .env.whop-sandbox.local. Never use your live credentials here.
# Use a separate EMPTY development database, not the normal app database.
DATABASE_URL=REPLACE_WITH_SEPARATE_TEST_DATABASE_URL
WHOP_API_KEY=REPLACE_WITH_SANDBOX_API_KEY
WHOP_BUSINESS_ID=REPLACE_WITH_SANDBOX_BIZ_ID
WHOP_PRO_PRODUCT_ID=REPLACE_WITH_SANDBOX_PROD_ID
WHOP_PRO_MONTHLY_PLAN_ID=REPLACE_WITH_SANDBOX_PLAN_ID
WHOP_WEBHOOK_SECRET=REPLACE_WITH_SANDBOX_WS_SECRET
# HTTPS tunnel origin used for sign-in and checkout returns. Whop rejects HTTP returns.
WHOP_SANDBOX_PUBLIC_URL=https://REPLACE_WITH_YOUR_TUNNEL_HOST
