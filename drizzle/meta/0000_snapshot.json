          "value": "(\"trading_accounts\".\"opening_balance\" is null and \"trading_accounts\".\"opening_balance_date\" is null) or (\"trading_accounts\".\"opening_balance\" is not null and \"trading_accounts\".\"opening_balance_date\" is not null)"
        },
