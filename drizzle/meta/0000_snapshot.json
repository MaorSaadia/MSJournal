          "name": "trading_accounts_firm_required",
          "value": "\"trading_accounts\".\"stage\" = 'Personal' or (\"trading_accounts\".\"firm\" is not null and length(trim(\"trading_accounts\".\"firm\")) > 0)"
        },
        "trading_accounts_opening_pair": {
